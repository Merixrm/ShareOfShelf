# =============================================================================
# ShareOfShelf web dashboard (web-base44/): .gitignore
#
# Rules for the Node / Vite / Base44 app in this folder. The Python pipeline
# and data/ rules live in the repository-root .gitignore.
#
# Check why a file is (or is not) ignored with:
#   git check-ignore -v <path>
# =============================================================================

# ── Environment and secrets ──────────────────────────────────────────────────
# .env.local holds VITE_SHELF_API_URL and the VITE_BASE44_* values.
# Anything named .env* or *.local is machine-specific and must never be committed.
.env
.env.*
*.local

# ── Base44 ───────────────────────────────────────────────────────────────────
# Per-clone pointer to the Base44 app id, written by `base44 link`. Every
# developer links their own clone, so it is not shared.
base44/.app.jsonc

# ── Dependencies ─────────────────────────────────────────────────────────────
# Installed by `npm install` from package-lock.json (which IS committed).
node_modules/

# ── Build output ─────────────────────────────────────────────────────────────
# Regenerated by every `npm run build`; the Base44 deploy runs a build itself.
dist/
dist-ssr/
.vite/
# Nitro server build output, used if this app ever gains a server.
.output/
.wrangler/
# TypeScript incremental build info (npm run typecheck).
*.tsbuildinfo

# ── Logs ─────────────────────────────────────────────────────────────────────
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Test coverage ────────────────────────────────────────────────────────────
coverage/

# ── Editors and operating systems ────────────────────────────────────────────
# .vscode/extensions.json is kept so recommended extensions are shared.
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
